{
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.13",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.45.4"
  },
  "tasks": {
    "test:functions": "deno test --allow-env supabase/functions",
    "test:api": "deno test --allow-env --allow-net tests/api",
    "check": "deno check supabase/functions/*/handler.ts supabase/functions/*/index.ts tests/api/*.ts"
  },
  "fmt": {
    "lineWidth": 120,
    "include": [
      "supabase/functions",
      "tests"
    ]
  },
  "lint": {
    "include": [
      "supabase/functions",
      "tests"
    ]
  }
}
